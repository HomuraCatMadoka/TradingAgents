# Production environment template. Do not commit real secrets.
# SECURITY: replace all placeholder secrets with strong, unique values before deployment.

TELEGRAM_BOT_TOKEN=replace_me

# JWT
JWT_SECRET=replace_me_with_random_64_chars
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_DAYS=7

# Database (PostgreSQL only in production)
DATABASE_URL=postgresql+asyncpg://postgres:strong_password@db-host:5432/miniapp
ALEMBIC_CONFIG=miniapp/backend/alembic.ini
SQL_ECHO=0

# Redis (caching, sessions, rate limiting)
REDIS_URL=redis://:strong_password@redis-host:6379/0
REDIS_SSL=false

# Optional: observability
LOG_LEVEL=info
