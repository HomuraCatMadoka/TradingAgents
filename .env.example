# DeFi Agent 环境变量配置示例
# 复制此文件为.env并填入实际的API密钥

# ========== LLM Provider ==========
# Google Gemini API Key（免费）
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ========== 多 API Key 轮询（推荐，提升配额）==========
# 如果配置了 GOOGLE_API_KEYS，将自动启用多 key 轮询
# 配额提升：单 key 15 RPM → 多 key 30-75 RPM
#
# 使用方法：
# 1. 创建 3-5 个 Google 账号（免费）
# 2. 每个账号生成 AI Studio API Key: https://aistudio.google.com/app/apikey
# 3. 填入下方（逗号分隔，不要有空格）：
#
# GOOGLE_API_KEYS=AIzaSyAbc123...,AIzaSyDef456...,AIzaSyGhi789...
#
# 功能：
# - 遇到 429 配额错误自动切换到下一个 key
# - Key 冷却 60 秒后自动恢复
# - 支持 3-5 个 key，总配额 45-75 RPM

# OpenAI API Key（可选，如果使用OpenAI）
OPENAI_API_KEY=your_openai_api_key_here

# ========== DeFi Data Sources ==========
# The Graph API Key（免费100K queries/月）
THE_GRAPH_API_KEY=your_thegraph_api_key_here

# Alpha Vantage API Key（暂未使用）
ALPHA_VANTAGE_API_KEY=alpha_vantage_api_key_placeholder

# ========== Telegram Bot ==========
# Telegram Bot Token（从@BotFather获取）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Agent配置类型（gemini/openai/ollama）
AGENT_CONFIG_TYPE=gemini

# Bot行为配置
BOT_MAX_MESSAGE_LENGTH=4096
BOT_ENABLE_PROGRESS=true
BOT_ANALYSIS_TIMEOUT=180

# Bot安全配置
BOT_ENABLE_SANITIZATION=true
BOT_RATE_LIMIT_PER_USER=10
BOT_RATE_LIMIT_WINDOW=3600

# Bot管理员用户ID（逗号分隔，可选，豁免速率限制；仅支持数字ID）
# BOT_ADMIN_USER_IDS=123456789,987654321

# ========== Redis 缓存配置 ==========
# Redis 连接 URL，用于存储分析结果缓存（默认本地实例）
REDIS_URL=redis://localhost:6379/0

# 是否启用分析结果缓存（false 时跳过所有 Redis 逻辑）
BOT_CACHE_ENABLED=true

# 缓存有效期（秒），默认 1800 = 30 分钟，负数将回退到默认值
BOT_CACHE_TTL_SECONDS=1800

# ========== RPC Nodes（可选）==========
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
